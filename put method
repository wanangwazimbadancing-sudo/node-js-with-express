app.put("/products/:id", (req,res)=>{

    const name = req.body;
    const id = req.params.id;

    const product = products.find((p)=> p.id == id);
    if(!product){
        return res.status(404).send("Product not found");
    }
    product.name = name;

    res.status(200).send({
        message: "Product updated",
        data: product
    });

});
